@startuml UC2 — Registered User Use Cases
title SmartStays — Registered User Use Cases

left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #E8F5E9
  BorderColor #388E3C
  ArrowColor #388E3C
}

actor "Registered User" as U #LightGreen

rectangle "SmartStays — User Features" {
  usecase "Browse / Search Rooms" as UC1
  usecase "View Room Details" as UC2
  usecase "Book a Room" as UC7
  usecase "Select Meal Plan" as UC8
  usecase "Apply Coupon Code" as UC9
  usecase "Make Payment" as UC10
  usecase "View Profile &\nBooking History" as UC11
  usecase "Cancel Booking" as UC12
  usecase "Leave a Review" as UC13
  usecase "Manage Wishlist" as UC14
  usecase "Receive Notifications" as UC15
  usecase "Delete Account" as UC16
}

U --> UC1
U --> UC2
U --> UC7
U --> UC8
U --> UC9
U --> UC10
U --> UC11
U --> UC12
U --> UC13
U --> UC14
U --> UC15
U --> UC16

UC7 ..> UC8 : <<include>>
UC7 ..> UC9 : <<include>>
UC7 ..> UC10 : <<include>>

@enduml
